            "type": "string",
            "defaultValue": "0505-074802-czas06fv"
        },
        "LS_ADLS001_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://adlsdevsales001.dfs.core.windows.net/"
        },
        "LS_ADLS002_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://adlsdevsales002.dfs.core.windows.net/"
        }
    },
