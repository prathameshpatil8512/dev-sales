{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Data Factory name",
            "defaultValue": "adfdevsales001"
        },
        "AzureDatabricks1_accessToken": {
            "type": "secureString",
            "metadata": "Secure string for 'accessToken' of 'AzureDatabricks1'"
        },
        "LS_ADLS001_accountKey": {
            "type": "secureString",
            "metadata": "Secure string for 'accountKey' of 'LS_ADLS001'"
        },
        "LS_ADLS002_accountKey": {
            "type": "secureString",
            "metadata": "Secure string for 'accountKey' of 'LS_ADLS002'"
        },
        "AzureDatabricks1_properties_typeProperties_existingClusterId": {
            "type": "string",
            "defaultValue": "0505-074802-czas06fv"
        },
        "LS_ADLS001_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://adlsdevsales001.dfs.core.windows.net/"
        },
        "LS_ADLS002_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://adlsdevsales002.dfs.core.windows.net/"
        },
        "containerUri": {
            "type": "string",
            "metadata": "URI to storage account containing linked ARM templates"
        },
        "containerSasToken": {
            "type": "string",
            "metadata": "Sas token to storage account containing linked ARM templates"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "adfdevsales001_ArmTemplate_0",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2024-03-01",
            "properties": {
                "mode": "incremental",
                "templateLink": {
                    "uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "factoryName": {
                        "value": "[parameters('factoryName')]"
                    },
                    "AzureDatabricks1_accessToken": {
                        "value": "[parameters('AzureDatabricks1_accessToken')]"
                    },
                    "LS_ADLS001_accountKey": {
                        "value": "[parameters('LS_ADLS001_accountKey')]"
                    },
                    "LS_ADLS002_accountKey": {
                        "value": "[parameters('LS_ADLS002_accountKey')]"
                    },
                    "AzureDatabricks1_properties_typeProperties_existingClusterId": {
                        "value": "[parameters('AzureDatabricks1_properties_typeProperties_existingClusterId')]"
                    },
                    "LS_ADLS001_properties_typeProperties_url": {
                        "value": "[parameters('LS_ADLS001_properties_typeProperties_url')]"
                    },
                    "LS_ADLS002_properties_typeProperties_url": {
                        "value": "[parameters('LS_ADLS002_properties_typeProperties_url')]"
                    }
                }
            },
            "dependsOn": []
        }
    ]
}